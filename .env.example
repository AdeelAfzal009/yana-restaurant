# Postgres connection string.
# Local:   postgres://postgres:postgres@localhost:5432/yana
# Railway: injected automatically as DATABASE_URL by the Postgres plugin
DATABASE_URL=postgres://postgres:postgres@localhost:5432/yana

# Signs the admin session cookie. Generate with: openssl rand -base64 48
# Changing this signs every staff member out.
ADMIN_SESSION_SECRET=change-this-to-a-long-random-value

# Used only by `npm run db:seed-admin` to create the first manager account.
# Set these, run the seed once, then remove them.
SEED_ADMIN_EMAIL=manager@yanarestaurants.com
SEED_ADMIN_NAME=Restaurant Manager
SEED_ADMIN_PASSWORD=

# ---- Reservation emails (Resend) ----
# Without RESEND_API_KEY the app runs in dry-run mode: emails are logged to the
# console and recorded as "skipped", never sent. Get a key at resend.com.
RESEND_API_KEY=
# Must be an address on a domain verified in Resend. Before the domain is
# verified, "YANA Restaurant <onboarding@resend.dev>" works but only delivers
# to the Resend account owner's own address.
MAIL_FROM="YANA Restaurant <reservations@yanarestaurants.com>"
# Where guest replies land.
MAIL_REPLY_TO=reservations@yanarestaurants.com
# Inbox that gets a copy of every new online booking. Leave blank to disable.
MAIL_STAFF_TO=
# Used for links and buttons inside the emails.
MAIL_SITE_URL=https://yana-restaurant-production.up.railway.app
MAIL_PHONE="+971 2 447 6998"
# Set to 1 to force dry-run even when a key is present.
MAIL_DRY_RUN=

# ---- Yana Honors wallet cards ----
# Each wallet is off until all of its values are set; the dashboard says so.
#
# Google Wallet: Google Pay & Wallet Console → issuer ID. Google Cloud →
# service account with a JSON key, added as a user in the Wallet Console.
# The private key is the "private_key" value from the JSON (one line with \n).
GOOGLE_WALLET_ISSUER_ID=
GOOGLE_WALLET_SA_EMAIL=
GOOGLE_WALLET_SA_PRIVATE_KEY=
# Card ids start with this. Use a different one for a test copy (docker-compose
# uses "local") so it never changes the live site's cards. Live: leave unset.
GOOGLE_WALLET_OBJECT_PREFIX=
#
# Apple Wallet: Apple Developer → Identifiers → Pass Type ID, then its
# certificate. PEM text (one line with \n is fine): the certificate, its
# private key (and passphrase, if any) and Apple's WWDR G4 certificate.
APPLE_PASS_TYPE_ID=pass.com.yanarestaurants.honors
APPLE_TEAM_ID=
APPLE_PASS_CERT=
APPLE_PASS_KEY=
APPLE_PASS_KEY_PASSPHRASE=
APPLE_WWDR_CERT=
